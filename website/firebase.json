{
  "hosting": {
    "target": "scout",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm --prefix \"$PROJECT_DIR/..\" run build"],
    "headers": [{
      "source": "**",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://vhlfumeyhkeospnemukq.supabase.co; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
