00%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/0afe5a90-478c-4ec2-b335-ad74d151c1ea_956/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/0afe5a90-478c-4ec2-b335-ad74d151c1ea_956/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"b98d756fe296e5635e2c\" id=\"block-b98d756fe296e5635e2c\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">This practical webinar demonstrates how large language models can help people work with real ocean data in the Ocean Data Platform.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Using AI Skills and ODP, we’ll show how to:</p><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Discover relevant ocean datasets using natural-language questions</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Query, filter, and analyse data through ODP</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Turn data and analysis into an interactive map or prototype</p></li></ul><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">The session will focus on practical demonstrations of LLM-assisted workflows, including examples of prototypes built with real ODP data. We’ll also discuss how to verify results and develop reliable, reproducible workflows.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">The webinar is intended for researchers, analysts, developers, and practitioners interested in combining ocean data with AI tools.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-b98d756fe296e5635e2c {\n    \n    \n    \n  }\n\n  #block-b98d756fe296e5635e2c .sqs-html-content {\n    \n    }\n\n  #block-b98d756fe296e5635e2c {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n\n\n\n  \n  \n\n  \n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-b98d756fe296e5635e2c {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-b98d756fe296e5635e2c .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/6ea0fb7d-1b91-4a53-8399-480ef8b04822_1126/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/6ea0fb7d-1b91-4a53-8399-480ef8b04822_1126/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.co