# Public browser configuration lives in website/.env.example.
# Copy the needed entries into the ignored root .env.local for this checkout.
# Empty placeholders are not credentials. Never commit values or upload this file wholesale.

# Local Supabase CLI/Management API authentication, with access to the Scout project.
# Function deployment requires Edge Functions write permission. Not a hosted function secret.
SUPABASE_ACCESS_TOKEN=

# Calls the deployed reader/notification endpoints; this key cannot deploy functions.
SCOUT_BACKEND_KEY=

# Local model diagnostics. The hosted reader uses SCOUT_GEMINI_API_KEY instead of GEMINI_API_KEY.
GEMINI_API_KEY=
SCOUT_OPENAI_API_KEY=
