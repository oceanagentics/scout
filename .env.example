# Public browser configuration lives in website/.env.example.
# Backend only: use the same key/name in .env.local and Supabase Edge Function Secrets.
SCOUT_OPENAI_API_KEY=

# Edge-function secrets: reuse the OAuth client configured for Supabase Google sign-in.
# Never use VITE_ for these. The user's refresh token is captured at consent into Vault.
SCOUT_GOOGLE_CLIENT_ID=
SCOUT_GOOGLE_CLIENT_SECRET=
